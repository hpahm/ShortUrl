PORT=4116
# Public address of the site; short links are built from it.
BASE_URL=http://localhost:4116
# SQLite database file (created automatically).
DB_PATH=./data/urls.db
# Max links one IP can create per minute.
RATE_LIMIT_PER_MIN=30
# Set to 1 when running behind one reverse proxy (nginx, Cloudflare...) so rate limits see the real client IP.
TRUST_PROXY=
